{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit":              false,
    "composite":           true,
    "declaration":         true,
    "declarationMap":      true,
    "emitDeclarationOnly": true,
    "outDir":              "./dist",
    "rootDir":             "./src"
  },
  "exclude": ["src/__tests__/**", "src/**/*.test.ts", "src/**/*.spec.ts", "src/**/*.prop.ts"]
}
